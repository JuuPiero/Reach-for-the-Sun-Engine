{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@rs/core": ["./packages/core/src/index.ts"],
      "@rs/render-babylon": ["./packages/render-babylon/src/index.ts"],
      "@rs/runtime": ["./packages/runtime/src/index.ts"],
      "@rs/editor": ["./packages/editor/src/api.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/vite", "packages/*/tests", "packages/editor/server", "examples/*/Assets"]
}
